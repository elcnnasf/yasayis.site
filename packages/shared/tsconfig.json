{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023"],
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "//": "Testlər paketə daxil edilmir: `dist` istehsalat kodudur və vitest onun asılılığı deyil.",
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
