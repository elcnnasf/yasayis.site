# =============================================================
#  Yaşayış — mühit dəyişənləri
#  Bu faylı `.env` adı ilə kopyalayın və dəyərləri doldurun.
#  `.env` HEÇ VAXT commit olunmur.
# =============================================================

# --- Baza (Supabase Postgres) -------------------------------
# Supabase Dashboard → Project Settings → Database → Connection string
# DATABASE_URL      : tətbiqin işlədiyi pooled bağlantı (port 6543, pgbouncer)
#
# connection_limit=1 QOYMAYIN — o, serverless üçündür. Uzunömürlü Nest
# prosesində bütün sorğular tək bağlantıda növbəyə düzülür və paralel
# sorğuların bir hissəsi pool timeout-una düşür.
# DIRECT_URL        : migration üçün birbaşa bağlantı (port 5432)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PAROL@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PAROL@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Fayl saxlama -------------------------------------------
# local    : fayllar apps/api/uploads/ altına yazılır (yalnız dev)
# supabase : Supabase Storage bucket-inə yüklənir (prod üçün məcburi)
STORAGE_DRIVER="local"
PUBLIC_URL="http://localhost:4000"

# --- Supabase Storage (elan şəkilləri) ----------------------
SUPABASE_PROJECT_REF="PROJECT_REF"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""        # yalnız server tərəfdə, brauzerə düşməməlidir
SUPABASE_STORAGE_BUCKET="listings"

# Supabase hesab səviyyəli token (yalnız CLI/idarəetmə üçün, tətbiq işlətmir)
SUPABASE_ACCESS_TOKEN=""

# --- API ----------------------------------------------------
API_PORT=4000
API_PREFIX="/api/v1"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# --- Auth ---------------------------------------------------
# openssl rand -base64 48  ilə yaradın
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Sessiya cookie-sinin SameSite dəyəri.
#   lax  — web və API eyni saytdadır (yasayis.site + api.yasayis.site). Standart.
#   none — API başqa domendədir. HTTPS məcburidir, yoxsa giriş işləmir.
COOKIE_SAMESITE="lax"

# --- Google OAuth -------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/giris/google"

# --- E-poçt -------------------------------------------------
EMAIL_PROVIDER="console"
EMAIL_FROM="Yaşayış <noreply@yasayis.site>"

# --- Monetizasiya -------------------------------------------
# Ödəniş inteqrasiyası YOXDUR — bu bayraq false qalmalıdır.
MONETIZATION_ENABLED="false"

# --- SMS / OTP (yerli provayder) ----------------------------
SMS_PROVIDER="console"              # dev-də konsola yazır, real SMS göndərmir
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER="Yasayis"

# --- Web ----------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Nümunə (demo) məlumat: API boş və ya əlçatmaz olanda hazır elan/profil göstərilsin?
#   İnkişafda standart olaraq AÇIQ, istehsalatda SÖNÜLÜdür.
#   Canlı saytda uydurma elan göstərmək yolverilməzdir — yalnız
#   nümayiş stendi üçün "true" yazın.
NEXT_PUBLIC_ENABLE_DEMO_DATA="false"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
